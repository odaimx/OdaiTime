# Copia este archivo a .env en el servidor y cambia los valores.

ENVIRONMENT=staging
DEBUG=false

# Dominio público. Con un dominio real, Caddy obtiene HTTPS solo.
# Para probar solo por IP deja ":80".
DOMAIN=:80

POSTGRES_DB=odaitime
POSTGRES_USER=odaitime
# Genera una con: openssl rand -base64 32
POSTGRES_PASSWORD=cambia-esta-contrasena

# Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esta-llave

DEFAULT_TIMEZONE=America/Mexico_City
CORS_ORIGINS=["https://tu-dominio.mx"]
API_WORKERS=2
