# Copia este archivo a .env en el servidor y cambia los valores.

ENVIRONMENT=staging
DEBUG=false
# true = base de datos de demostración (el pie de página muestra "Licencia demo").
DEMO=false

# Dominio de los clientes: cada empresa entra por <subdominio>.DOMAIN (p. ej. hotel.odai.lat).
# ADMIN_HOST es la dirección del panel de Odai (superadmin).
# DNS: ADMIN_HOST → IP del VPS y *.DOMAIN → IP del VPS (los registros explícitos, como www, no cambian).
# Caddy obtiene los certificados HTTPS solo. Por IP (http://IP) siempre se puede entrar sin subdominio.
DOMAIN=odai.lat
ADMIN_HOST=time.odai.lat
# Subdominios extra que ningún cliente podrá usar (además de www, mail, blog, odoo, erp…).
SUBDOMINIOS_RESERVADOS=

POSTGRES_DB=odaitime
POSTGRES_USER=odaitime
# Genera una con: openssl rand -base64 32
POSTGRES_PASSWORD=cambia-esta-contrasena

# Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esta-llave

DEFAULT_TIMEZONE=America/Mexico_City
CORS_ORIGINS=["https://tu-dominio.mx"]
API_WORKERS=2
